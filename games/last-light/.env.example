# Copy to .env; keep credentials outside source control and Unity Player.
LAST_LIGHT_MODEL=qwen3.8-flash
# The verified Qwen endpoint supports none; this avoids spending the output cap on hidden reasoning.
LAST_LIGHT_REASONING=none
LAST_LIGHT_API=chat_completions
LAST_LIGHT_BASE_URL=
LAST_LIGHT_API_KEY=
# Optional: reuse a configured local Codex provider at exactly its configured URL.
LAST_LIGHT_USE_CODEX_AUTH=0
# Configurable play-service budget; not automatically spent. Save restore never refunds tokens.
# The development live_eval.py always independently caps its entire evaluation at 200000.
LAST_LIGHT_TOKEN_BUDGET=1000000
