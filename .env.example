# Required only for live Agent runs.
OPENAI_API_KEY=

# Leave empty to use the OpenAI Agents SDK default model, or pin a model explicitly.
NPC_DIRECTOR_MODEL=
NPC_DIRECTOR_DIRECTOR_MODEL=
NPC_DIRECTOR_NARRATIVE_MODEL=
NPC_DIRECTOR_LORE_MODEL=
NPC_DIRECTOR_SCREENWRITER_MODEL=
NPC_DIRECTOR_PERFORMANCE_MODEL=
NPC_DIRECTOR_JUDGE_MODEL=
NPC_DIRECTOR_FALLBACK_MODEL=

# Model customization profile: default / idealab_deepseek / idealab_qwen.
# Leave empty to infer from the model name
# (bailian/deepseek* -> idealab_deepseek, qwen* -> idealab_qwen).
NPC_DIRECTOR_MODEL_PROFILE=
# Production defaults to the bounded semantic-router DAG; use react only for legacy ablations.
NPC_DIRECTOR_ORCHESTRATION_MODE=bounded
NPC_DIRECTOR_TIMEOUT_SECONDS=30
NPC_DIRECTOR_MAX_TURNS=4
NPC_DIRECTOR_MAX_SPECIALIST_CALLS=4
NPC_DIRECTOR_MAX_HANDOFFS=1
NPC_DIRECTOR_MAX_REPAIR_ATTEMPTS=2
# Episode-wide budgets shared by NPC turns, retries and content revisions.
NPC_DIRECTOR_MAX_EPISODE_PARTICIPANTS=4
NPC_DIRECTOR_MAX_AUTONOMOUS_TURNS=6
NPC_DIRECTOR_MAX_EXECUTION_NODES=32
NPC_DIRECTOR_MAX_MODEL_CALLS=32
NPC_DIRECTOR_MAX_PLAN_REVISIONS=2
NPC_DIRECTOR_MAX_NODE_REPAIRS=1
NPC_DIRECTOR_MAX_NEW_QUESTS=1
NPC_DIRECTOR_MAX_TOTAL_TOKENS=96000
NPC_DIRECTOR_PLANNING_TIMEOUT_SECONDS=180
NPC_DIRECTOR_MAX_OUTPUT_TOKENS=4096
NPC_DIRECTOR_QUALITY_REVIEW=true
# Native response schema for GPT; inline contract for other providers.
NPC_DIRECTOR_INLINE_OUTPUT_SCHEMA=auto
# Prompt JSON with strict validation avoids nested-schema decoder stalls.
NPC_DIRECTOR_PROMPT_JSON_SCHEMAS=NarrativePlan
NPC_DIRECTOR_NODE_REASONING_EFFORT=low
NPC_DIRECTOR_MAX_CONCURRENT_MODEL_CALLS=4
NPC_DIRECTOR_MODEL_RETRY_ATTEMPTS=3
NPC_DIRECTOR_LOW_CONFIDENCE_THRESHOLD=0.55
NPC_DIRECTOR_DATABASE_PATH=data/runtime/npc_director.db
NPC_DIRECTOR_LORE_PATH=data/world/lore
NPC_DIRECTOR_CHARACTER_PATH=data/characters
NPC_DIRECTOR_LORE_TOP_K=4
NPC_DIRECTOR_LORE_TOKEN_BUDGET=1200
NPC_DIRECTOR_CONTEXT_HISTORY_LIMIT=8
NPC_DIRECTOR_OUTBOX_RETRY_LIMIT=5

# Optional pricing inputs used only to estimate eval cost.
NPC_DIRECTOR_INPUT_COST_PER_MILLION=
NPC_DIRECTOR_OUTPUT_COST_PER_MILLION=

# Eval pass gate: weighted quality score threshold (default 0.75).
NPC_DIRECTOR_EVAL_SCORE_THRESHOLD=

# Optional owner-scoped persistent behavior and memory lifecycle.
# Keep false to reproduce the v2 baseline; true activates new episodes only.
NPC_DIRECTOR_COGNITION=false
NPC_DIRECTOR_MEMORY_MODEL=
NPC_DIRECTOR_MEMORY_HALF_LIFE=32
NPC_DIRECTOR_MEMORY_REFLECT_AFTER=8
NPC_DIRECTOR_MEMORY_DORMANT_THRESHOLD=0.1
# Evaluation only: use one persistent ledger for pilot, full, and all retries.
# NPC_DIRECTOR_EVAL_LEDGER=artifacts/cognition/live-budget.db
# NPC_DIRECTOR_EVAL_PHASE=pilot
