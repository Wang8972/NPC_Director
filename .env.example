# Required only for live Agent runs.
OPENAI_API_KEY=

# Leave empty to use the OpenAI Agents SDK default model, or pin a model explicitly.
NPC_DIRECTOR_MODEL=
NPC_DIRECTOR_DIRECTOR_MODEL=
NPC_DIRECTOR_NARRATIVE_MODEL=
NPC_DIRECTOR_LORE_MODEL=
NPC_DIRECTOR_SCREENWRITER_MODEL=
NPC_DIRECTOR_PERFORMANCE_MODEL=
NPC_DIRECTOR_JUDGE_MODEL=
NPC_DIRECTOR_FALLBACK_MODEL=
NPC_DIRECTOR_TIMEOUT_SECONDS=30
NPC_DIRECTOR_MAX_TURNS=4
NPC_DIRECTOR_MAX_SPECIALIST_CALLS=4
NPC_DIRECTOR_MAX_HANDOFFS=1
NPC_DIRECTOR_MAX_REPAIR_ATTEMPTS=2
NPC_DIRECTOR_MAX_CONCURRENT_MODEL_CALLS=4
NPC_DIRECTOR_MODEL_RETRY_ATTEMPTS=3
NPC_DIRECTOR_LOW_CONFIDENCE_THRESHOLD=0.55
NPC_DIRECTOR_DATABASE_PATH=data/runtime/npc_director.db
NPC_DIRECTOR_LORE_PATH=data/world/lore
NPC_DIRECTOR_CHARACTER_PATH=data/characters
NPC_DIRECTOR_LORE_TOP_K=4
NPC_DIRECTOR_LORE_TOKEN_BUDGET=1200
NPC_DIRECTOR_CONTEXT_HISTORY_LIMIT=8
NPC_DIRECTOR_OUTBOX_RETRY_LIMIT=5

# Optional pricing inputs used only to estimate eval cost.
NPC_DIRECTOR_INPUT_COST_PER_MILLION=
NPC_DIRECTOR_OUTPUT_COST_PER_MILLION=
