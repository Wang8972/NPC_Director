            "secondary": "wary",
            "intensity": 0.38,
            "valence": -0.05,
            "arousal": 0.3
          },
          "status": "completed",
          "turn_id": "npc:d34cd5e53c65d6ad3a688f97bcf4e6d86445192d"
        },
        {
          "role": "player",
          "npc_id": "elder_maren",
          "text": "那先核实路线，别替她答应。",
