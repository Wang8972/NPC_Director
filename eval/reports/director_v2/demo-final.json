          "status": "completed",
          "turn_id": "eval:cooperation_review_demo:1:main:turn:0"
        },
        {
          "role": "npc",
          "npc_id": "village_guard",
          "text": "我能确认值守记录，没亲眼见到的部分得再查。",
          "emotion": {
            "coarse": "neutral",
            "primary": "calm",
            "secondary": null,
